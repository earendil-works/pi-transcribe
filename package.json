{
  "name": "@earendil-works/pi-transcribe",
  "version": "0.0.2",
  "description": "Local speech-to-text dictation for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi-transcribe.git"
  },
  "homepage": "https://github.com/earendil-works/pi-transcribe#readme",
  "bugs": {
    "url": "https://github.com/earendil-works/pi-transcribe/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "transcription",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check",
    "prepublishOnly": "npm test",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:verify": "node scripts/verify-catalog.mjs",
    "catalog:update-metadata": "node scripts/update-catalog-metadata.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@huggingface/gguf": "^0.4.6",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@huggingface/hub": "2.15.0",
    "@picovoice/pvrecorder-node": "1.2.9",
    "opencc-js": "^1.4.1",
    "transcribe-cpp": "0.1.3"
  }
}
